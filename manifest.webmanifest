{
  "id": "./",
  "name": "PocketDocs",
  "short_name": "PocketDocs",
  "description": "Local-first PDF, PrintFit & document studio — merge, split, resize, convert, sign, redact & print at real size.",
  "start_url": "./index.html#home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#f6f8fc",
  "theme_color": "#2563eb",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "PrintFit (ID & Docs)",
      "short_name": "PrintFit",
      "url": "./index.html#add"
    },
    {
      "name": "Merge & Split PDF",
      "short_name": "Merge PDF",
      "url": "./index.html#ms"
    },
    {
      "name": "Resize",
      "short_name": "Resize",
      "url": "./index.html#comp"
    },
    {
      "name": "My Documents",
      "short_name": "My Docs",
      "url": "./index.html#docs"
    }
  ]
}